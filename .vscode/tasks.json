{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "unit test php",
      "type": "shell",
      "command": "npm run test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "XDEBUG_CONFIG": "idekey=VSCODE",
          "XDEBUG_MODE": "off"
        }
      },
      "problemMatcher": ["$phpunit"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
